main() {
    init_para
    case "${1:-menu}" in
        log)                shift; log_command "$@" ;;
        log-archive)        shift; archive_log "$PARA_LOG" "$PARA_LOG_ARCHIVE" global "${1:-}" ;;
        task)               shift; add_task "$@" ;;
        task-archive)       archive_done_tasks ;;
        note)               shift; CREATED_PATH=""; create_note "$@"
                            [[ -n "${CREATED_PATH:-}" ]] && edit_file "$CREATED_PATH" ;;
        project|projects)   shift; entity_command project "$@" ;;
        area|areas)         shift; entity_command area "$@" ;;
        resource|resources) shift; entity_command resource "$@" ;;
        project-archive)    shift; archive_entity project "${1:-}" ;;
        search-name)        shift; search_notes_by_name "$@" ;;
        search)             shift; search_notes_by_content "$@" ;;
        list|ls)            shift; list_command "$@" ;;
        stats|statistics)   show_stats ;;
        edit-log)           init_log_file "$PARA_LOG" "Log"; edit_file "$PARA_LOG" ;;
        edit-tasks)         init_tasks_file; edit_file "$PARA_TASKS" ;;
        init)               ok "PARA structure ready at $PARA_BASE" ;;
        menu)               show_menu ;;
        help|--help|-h)     show_help ;;
        *)                  printf '%sUnknown command: %s%s\n' "$RED" "$1" "$NC" >&2
                            printf "Run '%s help' for usage information\n" "$PROG" >&2
                            exit 1 ;;
    esac
}

main "$@"
