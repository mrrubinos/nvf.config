#!/usr/bin/env bash
# PARA Method CLI. Projects, areas, resources and archive.

set -uo pipefail

PROG="${PARA_PROG:-para}"

expand_tilde() {
    local p="${1-}"
    [[ "$p" == "~"* ]] && p="${p/#\~/$HOME}"
    printf '%s' "$p"
}

PARA_BASE="$(expand_tilde "${PARA_BASE:-$HOME/Documents/PARA}")"
PARA_LOG="$(expand_tilde "${PARA_LOG:-$PARA_BASE/log.md}")"
PARA_LOG_ARCHIVE="$(expand_tilde "${PARA_LOG_ARCHIVE:-$PARA_BASE/logs/archive}")"
PARA_TASKS="$(expand_tilde "${PARA_TASKS:-$PARA_BASE/tasks.md}")"
PARA_TASKS_ARCHIVE="$(expand_tilde "${PARA_TASKS_ARCHIVE:-$PARA_BASE/tasks_archive.md}")"
PARA_PROJECTS="$(expand_tilde "${PARA_PROJECTS:-$PARA_BASE/1_projects}")"
PARA_AREAS="$(expand_tilde "${PARA_AREAS:-$PARA_BASE/2_areas}")"
PARA_RESOURCES="$(expand_tilde "${PARA_RESOURCES:-$PARA_BASE/3_resources}")"
PARA_ARCHIVE="$(expand_tilde "${PARA_ARCHIVE:-$PARA_BASE/4_archive}")"

DATE_FORMAT="%Y-%m-%d"
DATETIME_FORMAT="%Y-%m-%d %H:%M:%S"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    NC=$'\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' CYAN='' BOLD='' DIM='' NC=''
fi

say()     { printf '%s\n' "$*"; }
ok()      { printf '%s%s%s\n' "$GREEN" "$*" "$NC"; }
warn()    { printf '%s%s%s\n' "$YELLOW" "$*" "$NC" >&2; }
die()     { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }
heading() { printf '%s%s%s\n' "$BOLD" "$*" "$NC"; }
dim()     { printf '%s%s%s\n' "$DIM" "$*" "$NC"; }

plural() {
    local word="$1" n="$2"
    if (( n == 1 )); then
        printf '%s' "$word"
    elif [[ "$word" == "entry" ]]; then
        printf 'entries'
    else
        printf '%ss' "$word"
    fi
}

now()   { date +"$DATETIME_FORMAT"; }
today() { date +"$DATE_FORMAT"; }

edit_file() { "${EDITOR:-nvim}" "$@"; }

slugify() {
    printf '%s' "$*" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

titlecase() {
    printf '%s' "$1" | tr '-' ' ' | sed -E 's/(^| )([a-z])/\1\U\2/g'
}

cat_dir() {
    case "${1-}" in
        project|projects)   printf '%s' "$PARA_PROJECTS" ;;
        area|areas)         printf '%s' "$PARA_AREAS" ;;
        resource|resources) printf '%s' "$PARA_RESOURCES" ;;
        archive|archives)   printf '%s' "$PARA_ARCHIVE" ;;
        *) return 1 ;;
    esac
}

cat_label() {
    case "${1-}" in
        project|projects)   printf 'Project' ;;
        area|areas)         printf 'Area' ;;
        resource|resources) printf 'Resource' ;;
        archive|archives)   printf 'Archive' ;;
        *) return 1 ;;
    esac
}

cat_plural() {
    case "${1-}" in
        project|projects)   printf 'Projects' ;;
        area|areas)         printf 'Areas' ;;
        resource|resources) printf 'Resources' ;;
        archive|archives)   printf 'Archive' ;;
        *) return 1 ;;
    esac
}

entity_dir()      { printf '%s/%s' "$(cat_dir "$1")" "$2"; }
entity_page()     { printf '%s/%s/%s.md' "$(cat_dir "$1")" "$2" "$2"; }
entity_notes_dir(){ printf '%s/%s/notes' "$(cat_dir "$1")" "$2"; }
entity_log()      { printf '%s/%s/log.md' "$(cat_dir "$1")" "$2"; }
entity_log_arch() { printf '%s/%s/logs/archive' "$(cat_dir "$1")" "$2"; }

init_para() {
    mkdir -p "$PARA_BASE" "$PARA_LOG_ARCHIVE" \
             "$PARA_PROJECTS" "$PARA_AREAS" "$PARA_RESOURCES" "$PARA_ARCHIVE"
    init_log_file "$PARA_LOG" "Log"
    init_tasks_file
}

init_log_file() {
    local path="$1" title="${2:-Log}"
    [[ -f "$path" ]] && return 0
    mkdir -p "$(dirname "$path")"
    printf '# %s\nCreated: %s\n\n' "$title" "$(now)" > "$path"
}

init_tasks_file() {
    [[ -f "$PARA_TASKS" ]] && return 0
    mkdir -p "$(dirname "$PARA_TASKS")"
    printf '# Tasks\nCreated: %s\n\n' "$(now)" > "$PARA_TASKS"
}

# A flat <slug>.md left over from the old layout becomes <slug>/<slug>.md, so
# that notes/ and log.md have somewhere to live.
promote_entity() {
    local root flat
    root="$(cat_dir "$1")" || return 1
    flat="$root/$2.md"
    if [[ -f "$flat" && ! -d "$root/$2" ]]; then
        mkdir -p "$root/$2"
        mv "$flat" "$root/$2/$2.md"
    fi
    mkdir -p "$root/$2"
}

list_entities() {
    local root
    root="$(cat_dir "$1")" || return 1
    [[ -d "$root" ]] || return 0
    {
        find "$root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null
        find "$root" -mindepth 1 -maxdepth 1 -type f -name '*.md' -printf '%f\n' 2>/dev/null \
            | sed 's/\.md$//'
    } | sort -u
}

count_notes() {
    local dir
    dir="$(entity_notes_dir "$1" "$2")"
    [[ -d "$dir" ]] || { printf '0'; return 0; }
    find "$dir" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' '
}

count_log_entries() {
    local log
    log="$(entity_log "$1" "$2")"
    [[ -f "$log" ]] || { printf '0'; return 0; }
    local n
    n=$(grep -c '^[0-9][0-9][0-9][0-9]-' "$log" 2>/dev/null)
    printf '%s' "${n:-0}"
}

entity_field() {
    local page field
    page="$(entity_page "$1" "$2")"
    field="$3"
    [[ -f "$page" ]] || return 1
    sed -nE "s/^${field}:[[:space:]]*(.+)$/\1/p" "$page" | head -1
}

# pick <prompt> <item>...  Prints the chosen item on stdout.
pick() {
    local prompt="$1"; shift
    (( $# == 0 )) && return 1
    if command -v fzf >/dev/null 2>&1 && [[ -t 2 ]]; then
        printf '%s\n' "$@" | fzf --prompt="$prompt " --height=40% --reverse --no-multi
        return $?
    fi
    local PS3="$prompt "
    local choice
    select choice in "$@"; do
        [[ -n "$choice" ]] && { printf '%s\n' "$choice"; return 0; }
        return 1
    done
    return 1
}

ask() {
    local prompt="$1" default="${2:-}" reply
    read -r -p "$prompt" reply
    printf '%s' "${reply:-$default}"
}

confirm() {
    local reply
    read -r -p "$1 (y/N): " reply
    [[ "$reply" == [yY] ]]
}

# resolve_entity <category> [name]
# 0 chosen, 1 no match, 2 nothing exists, 3 cancelled.
resolve_entity() {
    local category="$1" want="${2:-}"
    local slugs=()
    mapfile -t slugs < <(list_entities "$category")
    if [[ -n "$want" ]]; then
        local slug e
        slug="$(slugify "$want")"
        for e in ${slugs[@]+"${slugs[@]}"}; do
            [[ "$e" == "$slug" || "$e" == "$want" ]] && { printf '%s' "$e"; return 0; }
        done
        return 1
    fi
    (( ${#slugs[@]} == 0 )) && return 2
    local chosen
    chosen="$(pick "$(cat_label "$category"):" "${slugs[@]}")" || return 3
    [[ -z "$chosen" ]] && return 3
    printf '%s' "$chosen"
}

page_template() {
    local category="$1" name="$2"
    case "$category" in
        project)
            cat << TPL
# Project: $name

Created: $(now)
Status: Active
Due:
Priority: Normal

## Objective

## Success criteria

## Tasks
- [ ]

## Notes

## Resources

## Retrospective
TPL
            ;;
        area)
            cat << TPL
# Area: $name

Created: $(now)
Status: Active

## Overview

## Responsibilities

## Standards

## Recurring tasks
- [ ]

## Notes

## Resources
TPL
            ;;
        resource)
            cat << TPL
# Resource: $name

Created: $(now)
Source:
Tags:

## Summary

## Content

## References
TPL
            ;;
    esac
}

note_template() {
    local title="$1" category="$2" parent="$3"
    cat << TPL
# $title

Created: $(now)
Category: $(cat_label "$category")
Parent: $parent
Tags:

---

## Summary

## Content

## References
TPL
}

# ── Log ──────────────────────────────────────────────────────────────────────

# target_log <category> <slug>  Prints "logfile<TAB>archivedir<TAB>label".
target_log() {
    local category="${1:-}" slug="${2:-}"
    if [[ -z "$category" ]]; then
        printf '%s\t%s\t%s' "$PARA_LOG" "$PARA_LOG_ARCHIVE" "global"
    else
        promote_entity "$category" "$slug"
        printf '%s\t%s\t%s' \
            "$(entity_log "$category" "$slug")" \
            "$(entity_log_arch "$category" "$slug")" \
            "$(cat_label "$category" | tr '[:upper:]' '[:lower:]') $slug"
    fi
}

add_log_entry() {
    local logfile="$1" label="$2"; shift 2
    local entry="$*"
    [[ -z "$entry" ]] && entry="$(ask 'Log entry: ')"
    [[ -z "$entry" ]] && die "No log entry provided"
    init_log_file "$logfile" "Log"
    printf '%s - %s\n' "$(now)" "$entry" >> "$logfile"
    ok "Log entry added to $label"
}

show_log() {
    local logfile="$1" label="$2" count="${3:-50}"
    [[ -f "$logfile" ]] || { warn "No log for $label"; return 0; }
    heading "Log: $label"
    dim "$logfile"
    tail -n "$count" "$logfile" | while IFS= read -r line; do
        if [[ "$line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
            printf '%s%s%s%s\n' "$CYAN" "${line:0:19}" "$NC" "${line:19}"
        else
            printf '%s%s%s\n' "$DIM" "$line" "$NC"
        fi
    done
}

archive_log() {
    local logfile="$1" archdir="$2" label="$3" cutoff="${4:-}"
    [[ -z "$cutoff" ]] && cutoff="$(ask 'Archive entries before date (YYYY-MM-DD): ')"
    [[ "$cutoff" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "Invalid date format. Use YYYY-MM-DD"
    [[ -f "$logfile" ]] || die "No log for $label"

    local temp_current temp_archive
    temp_current="$(mktemp)"
    temp_archive="$(mktemp)"
    local moved=0

    while IFS= read -r line; do
        if [[ "$line" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}) ]] && [[ "${BASH_REMATCH[1]}" < "$cutoff" ]]; then
            printf '%s\n' "$line" >> "$temp_archive"
            moved=$((moved + 1))
        else
            printf '%s\n' "$line" >> "$temp_current"
        fi
    done < "$logfile"

    if (( moved == 0 )); then
        rm -f "$temp_current" "$temp_archive"
        warn "No entries before $cutoff in $label"
        return 0
    fi

    mkdir -p "$archdir"
    local archive_file="$archdir/log_archive_$(date +%Y%m%d_%H%M%S).md"
    {
        printf '# Archived Log Entries\nArchived: %s\nSource: %s\nEntries before: %s\n\n' \
            "$(now)" "$label" "$cutoff"
        cat "$temp_archive"
    } > "$archive_file"
    mv "$temp_current" "$logfile"
    rm -f "$temp_archive"
    ok "Archived $moved $(plural entry "$moved") from $label to $archive_file"
}

# ── Tasks ────────────────────────────────────────────────────────────────────

add_task_to_file() {
    local task_line="$1"
    init_tasks_file
    printf '%s\n' "$task_line" >> "$PARA_TASKS"
    local temp
    temp="$(mktemp)"
    head -n 3 "$PARA_TASKS" > "$temp"
    tail -n +4 "$PARA_TASKS" | grep -v '^[[:space:]]*$' | sort >> "$temp"
    mv "$temp" "$PARA_TASKS"
    ok "Task added"
}

add_task() {
    local priority="" description="" link=""
    while (( $# > 0 )); do
        case "$1" in
            --critical|-A) priority="A"; shift ;;
            --high|-B)     priority="B"; shift ;;
            --normal|-C)   priority="C"; shift ;;
            --low|-D)      priority="D"; shift ;;
            --someday|-E)  priority="E"; shift ;;
            --project|-p)  link="project:$(slugify "${2:-}")"; shift 2 ;;
            --area|-a)     link="area:$(slugify "${2:-}")"; shift 2 ;;
            --resource|-r) link="resource:$(slugify "${2:-}")"; shift 2 ;;
            --) shift; description="$description $*"; break ;;
            *)  description="$description $1"; shift ;;
        esac
    done
    description="${description# }"
    [[ -z "$description" ]] && description="$(ask 'Task description: ')"
    [[ -z "$description" ]] && die "No task description provided"

    if [[ -z "$priority" ]]; then
        local choice
        choice="$(pick 'Priority:' \
            'A - Critical' 'B - High' 'C - Normal' 'D - Low' 'E - Someday')" || return 1
        priority="${choice:0:1}"
    fi
    [[ -z "$priority" ]] && priority="C"

    local task_line
    if [[ "$priority" == "C" ]]; then
        task_line="- [ ] $description"
    else
        task_line="[$priority] - [ ] $description"
    fi
    [[ -n "$link" ]] && task_line="$task_line (${link/:/ })"
    add_task_to_file "$task_line"
}

archive_done_tasks() {
    [[ -f "$PARA_TASKS" ]] || die "Tasks file not found"
    local temp_pending temp_done count
    temp_pending="$(mktemp)"
    temp_done="$(mktemp)"
    head -n 3 "$PARA_TASKS" > "$temp_pending"
    tail -n +4 "$PARA_TASKS" | while IFS= read -r line; do
        if [[ "$line" == *'[x]'* ]]; then
            printf '%s\n' "$line" >> "$temp_done"
        elif [[ -n "$line" ]]; then
            printf '%s\n' "$line" >> "$temp_pending"
        fi
    done

    if [[ ! -s "$temp_done" ]]; then
        rm -f "$temp_pending" "$temp_done"
        warn "No completed tasks to archive"
        return 0
    fi
    count="$(wc -l < "$temp_done" | tr -d ' ')"

    [[ -f "$PARA_TASKS_ARCHIVE" ]] || printf '# Archived Tasks\n\n' > "$PARA_TASKS_ARCHIVE"
    {
        printf '\n## Archived on %s\n' "$(now)"
        cat "$temp_done"
    } >> "$PARA_TASKS_ARCHIVE"
    mv "$temp_pending" "$PARA_TASKS"
    rm -f "$temp_done"
    ok "Archived $count completed $(plural task "$count")"
}

colorize_task() {
    local line="$1"
    if [[ "$line" == *'[x]'* ]]; then
        printf '  %s%s%s\n' "$DIM" "$line" "$NC"
    else
        case "$line" in
            \[A\]*) printf '  %s%s%s\n' "$RED" "$line" "$NC" ;;
            \[B\]*) printf '  %s%s%s\n' "$YELLOW" "$line" "$NC" ;;
            \[D\]*) printf '  %s%s%s\n' "$CYAN" "$line" "$NC" ;;
            \[E\]*) printf '  %s%s%s\n' "$MAGENTA" "$line" "$NC" ;;
            *)      printf '  %s%s%s\n' "$BLUE" "$line" "$NC" ;;
        esac
    fi
}

list_tasks() {
    local filter="" only=""
    while (( $# > 0 )); do
        case "$1" in
            --project|-p)  filter="(project $(slugify "${2:-}"))"; shift 2 ;;
            --area|-a)     filter="(area $(slugify "${2:-}"))"; shift 2 ;;
            --resource|-r) filter="(resource $(slugify "${2:-}"))"; shift 2 ;;
            --open)        only="open"; shift ;;
            --done)        only="done"; shift ;;
            *) shift ;;
        esac
    done
    [[ -f "$PARA_TASKS" ]] || { warn "No tasks file found"; return 0; }
    heading "Tasks"
    local shown=0 line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ -n "$filter" && "$line" != *"$filter"* ]] && continue
        [[ "$only" == "open" && "$line" == *'[x]'* ]] && continue
        [[ "$only" == "done" && "$line" != *'[x]'* ]] && continue
        colorize_task "$line"
        shown=$((shown + 1))
    done < <(tail -n +4 "$PARA_TASKS")
    (( shown == 0 )) && dim "  (none)"
    return 0
}

# ── Notes ────────────────────────────────────────────────────────────────────

create_note() {
    local category="" parent="" title=""
    while (( $# > 0 )); do
        case "$1" in
            --project|-p)  category="project"; shift ;;
            --area|-a)     category="area"; shift ;;
            --resource|-r) category="resource"; shift ;;
            --in|-i)       parent="${2:-}"; shift 2 ;;
            --) shift; title="$title $*"; break ;;
            *) title="$title $1"; shift ;;
        esac
    done
    title="${title# }"

    if [[ -z "$category" ]]; then
        local choice
        choice="$(pick 'Category:' 'project' 'area' 'resource')" || return 1
        category="$choice"
    fi
    [[ -z "$category" ]] && return 1

    local slug rc
    slug="$(resolve_entity "$category" "$parent")"; rc=$?
    case $rc in
        1) die "No such $(cat_label "$category" | tr '[:upper:]' '[:lower:]'): $parent" ;;
        2) warn "No $(cat_plural "$category" | tr '[:upper:]' '[:lower:]') exist yet"
           local name
           name="$(ask "New $(cat_label "$category") name (Enter to cancel): ")"
           [[ -z "$name" ]] && return 1
           create_entity "$category" "$name" --no-open
           slug="$(slugify "$name")" ;;
        3) return 1 ;;
    esac

    [[ -z "$title" ]] && title="$(ask 'Note title: ')"
    [[ -z "$title" ]] && die "No note title provided"

    promote_entity "$category" "$slug"
    local notes_dir filepath
    notes_dir="$(entity_notes_dir "$category" "$slug")"
    mkdir -p "$notes_dir"
    filepath="$notes_dir/$(slugify "$title").md"

    if [[ -f "$filepath" ]]; then
        warn "Note already exists: $filepath"
    else
        note_template "$title" "$category" "$slug" > "$filepath"
        ok "Note created: $filepath"
    fi
    CREATED_PATH="$filepath"
}

list_notes_of() {
    local category="$1" slug="$2"
    local dir
    dir="$(entity_notes_dir "$category" "$slug")"
    [[ -d "$dir" ]] || return 0
    find "$dir" -maxdepth 1 -type f -name '*.md' -printf '%f\n' 2>/dev/null | sed 's/\.md$//' | sort
}

# ── Entities (project / area / resource) ─────────────────────────────────────

create_entity() {
    local category="$1"; shift
    local name="" open=1 bare=0
    while (( $# > 0 )); do
        case "$1" in
            --bare)     bare=1; shift ;;
            --no-open)  open=0; shift ;;
            --) shift; name="$name $*"; break ;;
            *) name="$name $1"; shift ;;
        esac
    done
    name="${name# }"
    [[ -z "$name" ]] && name="$(ask "New $(cat_label "$category") name: ")"
    [[ -z "$name" ]] && die "No name provided"

    local slug dir page
    slug="$(slugify "$name")"
    [[ -z "$slug" ]] && die "Name produces an empty slug: $name"
    dir="$(entity_dir "$category" "$slug")"
    page="$(entity_page "$category" "$slug")"

    if [[ -d "$dir" ]]; then
        warn "$(cat_label "$category") already exists: $slug"
    else
        mkdir -p "$dir"
        ok "$(cat_label "$category") created: $dir"
    fi

    if (( bare == 0 )) && [[ ! -f "$page" ]]; then
        page_template "$category" "$(titlecase "$slug")" > "$page"
        ok "Page created: $page"
    fi

    CREATED_PATH="$page"
    if (( open == 1 )); then
        [[ -f "$page" ]] && edit_file "$page" || edit_file "$dir"
    fi
}

cmd_entity_list() {
    local category="$1"
    local slugs=()
    mapfile -t slugs < <(list_entities "$category")
    heading "$(cat_plural "$category")"
    dim "$(cat_dir "$category")"
    if (( ${#slugs[@]} == 0 )); then
        dim "  (none)"
        return 0
    fi
    local slug notes logs status detail
    for slug in "${slugs[@]}"; do
        notes="$(count_notes "$category" "$slug")"
        logs="$(count_log_entries "$category" "$slug")"
        status="$(entity_field "$category" "$slug" 'Status' || true)"
        detail="$notes $(plural note "$notes"), $logs $(plural entry "$logs")"
        [[ -n "$status" ]] && detail="$status | $detail"
        [[ -f "$(entity_page "$category" "$slug")" ]] || detail="$detail | no page"
        printf '  %s%-28s%s %s%s%s\n' "$CYAN" "$slug" "$NC" "$DIM" "$detail" "$NC"
    done
}

cmd_entity_open() {
    local category="$1" want="${2:-}"
    local slug rc
    slug="$(resolve_entity "$category" "$want")"; rc=$?
    case $rc in
        1) die "No such $(cat_label "$category" | tr '[:upper:]' '[:lower:]'): $want" ;;
        2) warn "No $(cat_plural "$category" | tr '[:upper:]' '[:lower:]') exist yet"
           local name
           name="$(ask "New $(cat_label "$category") name (Enter to cancel): ")"
           [[ -z "$name" ]] && return 0
           create_entity "$category" "$name"
           return 0 ;;
        3) return 0 ;;
    esac

    promote_entity "$category" "$slug"
    local page
    page="$(entity_page "$category" "$slug")"
    if [[ -f "$page" ]]; then
        edit_file "$page"
        return 0
    fi

    # No page. Offer whatever the directory holds.
    local dir items=()
    dir="$(entity_dir "$category" "$slug")"
    mapfile -t items < <(find "$dir" -type f -name '*.md' -printf '%P\n' 2>/dev/null | sort)
    if (( ${#items[@]} == 0 )); then
        warn "$slug is empty. Creating its page."
        page_template "$category" "$(titlecase "$slug")" > "$page"
        edit_file "$page"
        return 0
    fi
    local choice
    choice="$(pick "Open in $slug:" "${items[@]}")" || return 0
    [[ -n "$choice" ]] && edit_file "$dir/$choice"
}

cmd_entity_note() {
    local category="$1"; shift
    local want="${1:-}"; (( $# > 0 )) && shift
    CREATED_PATH=""
    create_note "--${category}" --in "$want" "$@"
    [[ -n "${CREATED_PATH:-}" ]] && edit_file "$CREATED_PATH"
}

cmd_entity_notes() {
    local category="$1" want="${2:-}"
    local slug rc
    slug="$(resolve_entity "$category" "$want")"; rc=$?
    case $rc in
        1) die "No such $(cat_label "$category" | tr '[:upper:]' '[:lower:]'): $want" ;;
        2) warn "No $(cat_plural "$category" | tr '[:upper:]' '[:lower:]') exist yet"; return 0 ;;
        3) return 0 ;;
    esac
    local notes=()
    mapfile -t notes < <(list_notes_of "$category" "$slug")
    heading "Notes in $(cat_label "$category" | tr '[:upper:]' '[:lower:]') $slug"
    dim "$(entity_notes_dir "$category" "$slug")"
    if (( ${#notes[@]} == 0 )); then
        dim "  (none)"
        return 0
    fi
    local n
    for n in "${notes[@]}"; do
        printf '  %s%s%s\n' "$CYAN" "$n" "$NC"
    done
}

cmd_all_notes() {
    local category slug notes=() n found=0
    for category in project area resource; do
        local slugs=()
        mapfile -t slugs < <(list_entities "$category")
        for slug in ${slugs[@]+"${slugs[@]}"}; do
            mapfile -t notes < <(list_notes_of "$category" "$slug")
            (( ${#notes[@]} == 0 )) && continue
            found=1
            heading "$(cat_label "$category") $slug"
            for n in "${notes[@]}"; do
                printf '  %s%s%s\n' "$CYAN" "$n" "$NC"
            done
        done
    done
    (( found == 0 )) && dim "No notes found"
    return 0
}

archive_entity() {
    local category="$1" want="${2:-}"
    local slug rc
    slug="$(resolve_entity "$category" "$want")"; rc=$?
    case $rc in
        1) die "No such $(cat_label "$category" | tr '[:upper:]' '[:lower:]'): $want" ;;
        2) warn "Nothing to archive"; return 0 ;;
        3) return 0 ;;
    esac
    promote_entity "$category" "$slug"
    local src dst
    src="$(entity_dir "$category" "$slug")"
    dst="$PARA_ARCHIVE/$slug"
    if [[ -e "$dst" ]]; then
        dst="$PARA_ARCHIVE/${slug}_$(date +%Y%m%d_%H%M%S)"
        warn "Archive already holds $slug. Using $(basename "$dst")"
    fi
    mkdir -p "$PARA_ARCHIVE"
    mv "$src" "$dst" || die "Could not move $src"
    ok "Archived to $dst"
}

# ── Search and statistics ────────────────────────────────────────────────────

search_notes_by_name() {
    local query="$*"
    [[ -z "$query" ]] && query="$(ask 'Search names for: ')"
    [[ -z "$query" ]] && die "No search query provided"
    heading "Names matching '$query'"
    find "$PARA_BASE" -type f -name "*${query}*.md" -printf '%P\n' 2>/dev/null | sort \
        | while IFS= read -r f; do printf '  %s%s%s\n' "$CYAN" "$f" "$NC"; done
}

search_notes_by_content() {
    local query="$*"
    [[ -z "$query" ]] && query="$(ask 'Search contents for: ')"
    [[ -z "$query" ]] && die "No search query provided"
    heading "Contents matching '$query'"
    if command -v rg >/dev/null 2>&1; then
        rg --type md -C 2 --color=always -- "$query" "$PARA_BASE"
    else
        grep -rn --include='*.md' --color=always -C 2 -- "$query" "$PARA_BASE"
    fi
}

show_stats() {
    heading "PARA statistics"
    dim "$PARA_BASE"
    printf '\n'

    local category count notes total_notes=0
    heading "Entities"
    for category in project area resource; do
        local slugs=()
        mapfile -t slugs < <(list_entities "$category")
        count=${#slugs[@]}
        notes=0
        local slug
        for slug in ${slugs[@]+"${slugs[@]}"}; do
            notes=$(( notes + $(count_notes "$category" "$slug") ))
        done
        total_notes=$(( total_notes + notes ))
        printf "  %-12s %3d  %s(%d %s)%s\n" "$(cat_plural "$category")" "$count" "$DIM" "$notes" "$(plural note "$notes")" "$NC"
    done
    local archived
    archived=$(find "$PARA_ARCHIVE" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
    printf '  %-12s %3d\n' "Archive" "$archived"
    printf '  %-12s %3d\n' "Notes" "$total_notes"
    printf '\n'

    heading "Log"
    local entries=0
    [[ -f "$PARA_LOG" ]] && entries=$(grep -c '^[0-9][0-9][0-9][0-9]-' "$PARA_LOG" 2>/dev/null)
    printf '  %-12s %3d\n' "Global" "${entries:-0}"
    printf '\n'

    heading "Tasks"
    if [[ -f "$PARA_TASKS" ]]; then
        local pending done_ crit high
        pending=$(grep -c '\[ \]' "$PARA_TASKS" 2>/dev/null)
        done_=$(grep -c '\[x\]' "$PARA_TASKS" 2>/dev/null)
        crit=$(grep -c '^\[A\]' "$PARA_TASKS" 2>/dev/null)
        high=$(grep -c '^\[B\]' "$PARA_TASKS" 2>/dev/null)
        printf '  %-12s %3d\n' "Pending" "${pending:-0}"
        printf '  %-12s %3d\n' "Completed" "${done_:-0}"
        printf '  %-12s %3d\n' "Critical" "${crit:-0}"
        printf '  %-12s %3d\n' "High" "${high:-0}"
    else
        dim "  no tasks file"
    fi
}

# ── Interactive menu ─────────────────────────────────────────────────────────

entity_menu() {
    local category="$1"
    local label plural
    label="$(cat_label "$category")"
    plural="$(cat_plural "$category")"
    while true; do
        local choice
        choice="$(pick "$plural:" \
            "List $plural" \
            "Open $label" \
            "New $label" \
            "New note in $label" \
            "List notes in $label" \
            "Add log entry to $label" \
            "Show $label log" \
            "Open $label log" \
            "Archive log of $label" \
            "Archive $label" \
            "Back")" || return 0
        case "$choice" in
            "List $plural")             cmd_entity_list "$category" ;;
            "Open $label")              cmd_entity_open "$category" ;;
            "New $label")               create_entity "$category" ;;
            "New note in $label")       cmd_entity_note "$category" ;;
            "List notes in $label")     cmd_entity_notes "$category" ;;
            "Add log entry to $label")  entity_log_command "$category" add ;;
            "Show $label log")          entity_log_command "$category" show ;;
            "Open $label log")          entity_log_command "$category" edit ;;
            "Archive log of $label")    entity_log_command "$category" archive ;;
            "Archive $label")           archive_entity "$category" ;;
            "Back"|"")                  return 0 ;;
        esac
        printf '\n'
    done
}

tasks_menu() {
    while true; do
        local choice
        choice="$(pick 'Tasks:' \
            'List all tasks' 'List open tasks' 'List done tasks' \
            'Add task' 'Archive done tasks' 'Open tasks file' 'Back')" || return 0
        case "$choice" in
            'List all tasks')     list_tasks ;;
            'List open tasks')    list_tasks --open ;;
            'List done tasks')    list_tasks --done ;;
            'Add task')           add_task ;;
            'Archive done tasks') archive_done_tasks ;;
            'Open tasks file')    edit_file "$PARA_TASKS" ;;
            'Back'|'')            return 0 ;;
        esac
        printf '\n'
    done
}

log_menu() {
    while true; do
        local choice
        choice="$(pick 'Log:' \
            'Show global log' 'Add global log entry' 'Open global log' \
            'Archive global log entries' 'Back')" || return 0
        case "$choice" in
            'Show global log')            show_log "$PARA_LOG" global ;;
            'Add global log entry')       add_log_entry "$PARA_LOG" global ;;
            'Open global log')            edit_file "$PARA_LOG" ;;
            'Archive global log entries') archive_log "$PARA_LOG" "$PARA_LOG_ARCHIVE" global ;;
            'Back'|'')                    return 0 ;;
        esac
        printf '\n'
    done
}

search_menu() {
    while true; do
        local choice
        choice="$(pick 'Search:' 'By name' 'By content' 'Back')" || return 0
        case "$choice" in
            'By name')    search_notes_by_name ;;
            'By content') search_notes_by_content ;;
            'Back'|'')    return 0 ;;
        esac
        printf '\n'
    done
}

show_menu() {
    while true; do
        local choice
        choice="$(pick 'PARA:' \
            'Projects' 'Areas' 'Resources' 'Tasks' 'Log' 'Search' \
            'Statistics' 'Quit')" || return 0
        case "$choice" in
            'Projects')   entity_menu project ;;
            'Areas')      entity_menu area ;;
            'Resources')  entity_menu resource ;;
            'Tasks')      tasks_menu ;;
            'Log')        log_menu ;;
            'Search')     search_menu ;;
            'Statistics') show_stats ;;
            'Quit'|'')    return 0 ;;
        esac
        printf '\n'
    done
}

# ── Command dispatch ─────────────────────────────────────────────────────────

# entity_log_command <category> <action> [slug] [args...]
entity_log_command() {
    local category="$1" action="$2" want="${3:-}"
    shift 2; (( $# > 0 )) && shift
    local slug rc
    slug="$(resolve_entity "$category" "$want")"; rc=$?
    case $rc in
        1) die "No such $(cat_label "$category" | tr '[:upper:]' '[:lower:]'): $want" ;;
        2) warn "No $(cat_plural "$category" | tr '[:upper:]' '[:lower:]') exist yet"; return 0 ;;
        3) return 0 ;;
    esac
    local spec logfile archdir label
    spec="$(target_log "$category" "$slug")"
    IFS=$'\t' read -r logfile archdir label <<< "$spec"
    case "$action" in
        add)     add_log_entry "$logfile" "$label" "$@" ;;
        show)    show_log "$logfile" "$label" ;;
        edit)    init_log_file "$logfile" "Log"; edit_file "$logfile" ;;
        archive) archive_log "$logfile" "$archdir" "$label" "${1:-}" ;;
    esac
}

entity_command() {
    local category="$1"; shift
    local verb="${1:-}"
    case "$verb" in
        list|ls)       shift; cmd_entity_list "$category" ;;
        new|create)    shift; create_entity "$category" "$@" ;;
        open|edit)     shift; cmd_entity_open "$category" "${1:-}" ;;
        note)          shift; cmd_entity_note "$category" "$@" ;;
        notes)         shift; cmd_entity_notes "$category" "${1:-}" ;;
        log)           shift; entity_log_command "$category" add "$@" ;;
        log-show)      shift; entity_log_command "$category" show "${1:-}" ;;
        log-open)      shift; entity_log_command "$category" edit "${1:-}" ;;
        log-archive)   shift; entity_log_command "$category" archive "$@" ;;
        archive)       shift; archive_entity "$category" "${1:-}" ;;
        path)          shift
                       local s; s="$(resolve_entity "$category" "${1:-}")" \
                           && printf '%s\n' "$(entity_dir "$category" "$s")" ;;
        menu)          entity_menu "$category" ;;
        "")            entity_menu "$category" ;;
        *)             cmd_entity_open "$category" "$verb" ;;
    esac
}

list_command() {
    case "${1:-tasks}" in
        tasks|task)         shift || true; list_tasks "$@" ;;
        projects|project)   cmd_entity_list project ;;
        areas|area)         cmd_entity_list area ;;
        resources|resource) cmd_entity_list resource ;;
        archive|archived)   cmd_entity_list archive ;;
        notes)              shift
                            if [[ -n "${1:-}" ]]; then
                                local c
                                for c in project area resource; do
                                    if resolve_entity "$c" "$1" >/dev/null 2>&1; then
                                        cmd_entity_notes "$c" "$1"; return 0
                                    fi
                                done
                                die "No project, area or resource named: $1"
                            fi
                            cmd_all_notes ;;
        log|logs)           shift
                            if [[ -n "${1:-}" ]]; then
                                local c
                                for c in project area resource; do
                                    if resolve_entity "$c" "$1" >/dev/null 2>&1; then
                                        entity_log_command "$c" show "$1"; return 0
                                    fi
                                done
                                die "No project, area or resource named: $1"
                            fi
                            show_log "$PARA_LOG" global ;;
        *)                  die "Unknown list target: $1" ;;
    esac
}

log_command() {
    local category="" want=""
    while (( $# > 0 )); do
        case "$1" in
            --project|-p)  category="project";  want="${2:-}"; shift 2 ;;
            --area|-a)     category="area";     want="${2:-}"; shift 2 ;;
            --resource|-r) category="resource"; want="${2:-}"; shift 2 ;;
            *) break ;;
        esac
    done
    if [[ -n "$category" ]]; then
        entity_log_command "$category" add "$want" "$@"
    else
        add_log_entry "$PARA_LOG" global "$@"
    fi
}

